# ============================================================================
#  AI-Pub 环境变量示例
# ----------------------------------------------------------------------------
#  用法：复制为 deploy/.env 后填入真实值（deploy/.env 已被 .gitignore 忽略）
#      cp deploy/.env.example deploy/.env
# ============================================================================

# DeepSeek 大模型 API Key
# 未配置时 AI 回复会全部降级为默认话术（不报错，但功能不可用）
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AES-256 密钥：用于加密存储公众号 AppSecret / EncodingAESKey
# 未配置时后端使用内置默认密钥并在启动日志中告警 —— 该默认值随源码公开，
# 加密不具备实际保护作用，生产环境务必设置。
# 生成方式（32 字节随机值的 Base64）：
#   openssl rand -base64 32
#   Windows PowerShell: [Convert]::ToBase64String((1..32 | % {Get-Random -Max 256}))
AES_SECRET_KEY=

# JWT 签名密钥：用于签发/校验后台登录令牌
# 未配置时使用 application.yml 中的默认值（同样随源码公开），生产环境务必设置。
# 建议 32 字节以上随机字符串，生成方式同上。
JWT_SECRET=
